{
  "name": "bullmq-email-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker-cli.js",
    "dev": "tsx watch src/index.ts",
    "test": "node --env-file=.env.test --import tsx --test --test-force-exit test/**/*.test.ts",
    "test:debug": "node --inspect-brk=0.0.0.0:9229 --env-file=.env.test --import tsx --test --test-isolation=none --test-force-exit test/functional/worker.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bullmq": "^5.73.0",
    "express": "^5.2.1",
    "ioredis": "^5.10.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  }
}
